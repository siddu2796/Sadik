<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'><head><meta charset='utf-8'><title>Text To Word</title></head><body><p>/**<br>* ==============================================================================<br>* EVENTHUB - CORE CLIENT LOGIC (VANILLA JAVASCRIPT)<br>* Internal Department Event Ticket Booking &amp; Management System<br>* ==============================================================================<br>*/<br><br>// Global State Management &amp; Key<br>const STORAGE_KEYS = {<br>EVENTS: 'eventhub_events_data_v1',<br>BOOKINGS: 'eventhub_bookings_data_v1'<br>};<br><br>// Initial Events Catalogue<br>const DEFAULT_EVENTS = [<br>{<br>id: 'evt-101',<br>title: 'TechNova 2026: National Tech Symposium',<br>department: 'Computer Science &amp; Engineering',<br>category: 'Technical',<br>date: '2026-04-28T10:00:00',<br>venue: 'Main Auditorium (Hall A)',<br>price: 150,<br>totalSeats: 200,<br>availableSeats: 142,<br>desc: 'Keynote on Generative AI, Competitive Hackathon, Paper Presentations, and Code-in-the-Dark challenge.',<br>bannerGrad: 'linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%)'<br>},<br>{<br>id: 'evt-102',<br>title: 'AI &amp; Autonomous Robotics Summit',<br>department: 'Robotics &amp; Mechanical Eng',<br>category: 'Technical',<br>date: '2026-05-04T11:00:00',<br>venue: 'Robotics Center of Excellence',<br>price: 200,<br>totalSeats: 120,<br>availableSeats: 78,<br>desc: 'Hands-on ROS2 demo, autonomous drone aerial obstacle course, and AI vision workshops.',<br>bannerGrad: 'linear-gradient(135deg, #0ea5e9 0%, #3b82f6 100%)'<br>},<br>{<br>id: 'evt-103',<br>title: 'Full-Stack Web3 &amp; Cloud Bootcamp',<br>department: 'Information Technology',<br>category: 'Workshops',<br>date: '2026-05-12T09:30:00',<br>venue: 'Computing Lab 4 &amp; 5',<br>price: 100,<br>totalSeats: 90,<br>availableSeats: 24,<br>desc: 'Zero to hero cloud deployment, serverless microservices, and smart contract verification with industry mentors.',<br>bannerGrad: 'linear-gradient(135deg, #059669 0%, #10b981 100%)'<br>},<br>{<br>id: 'evt-104',<br>title: 'Resonance 2026: Inter-Department Cultural Fest',<br>department: 'Fine Arts &amp; Student Council',<br>category: 'Cultural',<br>date: '2026-05-18T17:00:00',<br>venue: 'Open Air Amphitheatre',<br>price: 250,<br>totalSeats: 500,<br>availableSeats: 380,<br>desc: 'Battle of the bands, western &amp; classical dance showdowns, fashion pro-nites, and celebrity musical performance.',<br>bannerGrad: 'linear-gradient(135deg, #e11d48 0%, #f43f5e 100%)'<br>},<br>{<br>id: 'evt-105',<br>title: 'PixelStorm: Esports Championship &amp; GameJam',<br>department: 'Multimedia &amp; Gaming Club',<br>category: 'Gaming',<br>date: '2026-05-24T13:00:00',<br>venue: 'Indoor Sports Arena',<br>price: 120,<br>totalSeats: 80,<br>availableSeats: 12,<br>desc: 'Valorant, BGMI, and Rocket League lan finals plus a 24-hour indie game design showcase.',<br>bannerGrad: 'linear-gradient(135deg, #d97706 0%, #f59e0b 100%)'<br>},<br>{<br>id: 'evt-106',<br>title: 'Quantum Computing &amp; Modern Cryptography',<br>department: 'Physics &amp; Applied Mathematics',<br>category: 'Workshops',<br>date: '2026-06-02T10:30:00',<br>venue: 'Sir CV Raman Lecture Theater',<br>price: 180,<br>totalSeats: 100,<br>availableSeats: 89,<br>desc: 'Exploration of Qiskit, quantum superposition principles, and post-quantum encryption protocols.',<br>bannerGrad: 'linear-gradient(135deg, #7c3aed 0%, #9333ea 100%)'<br>}<br>];<br><br>// Initial Demo Bookings<br>const DEFAULT_BOOKINGS = [<br>{<br>ticketId: 'EH-82914',<br>eventId: 'evt-101',<br>eventName: 'TechNova 2026: National Tech Symposium',<br>eventDept: 'Computer Science &amp; Engineering',<br>eventDate: '2026-04-28T10:00:00',<br>venue: 'Main Auditorium (Hall A)',<br>attendeeName: 'Aarav Patel',<br>rollNo: '2023CS201',<br>email: 'aarav.patel@univ.edu',<br>phone: '9845012345',<br>tier: 'VIP Delegate 🌟',<br>quantity: 2,<br>paidAmount: 600,<br>bookingTime: '2026-04-01 14:32',<br>checkedIn: false<br>},<br>{<br>ticketId: 'EH-39401',<br>eventId: 'evt-102',<br>eventName: 'AI &amp; Autonomous Robotics Summit',<br>eventDept: 'Robotics &amp; Mechanical Eng',<br>eventDate: '2026-05-04T11:00:00',<br>venue: 'Robotics Center of Excellence',<br>attendeeName: 'Pooja Sundaram',<br>rollNo: '2024ROB12',<br>email: 'pooja.sundaram@univ.edu',<br>phone: '9123456789',<br>tier: 'Standard Entry',<br>quantity: 1,<br>paidAmount: 200,<br>bookingTime: '2026-04-02 09:15',<br>checkedIn: true<br>},<br>{<br>ticketId: 'EH-55192',<br>eventId: 'evt-104',<br>eventName: 'Resonance 2026: Inter-Department Cultural Fest',<br>eventDept: 'Fine Arts &amp; Student Council',<br>eventDate: '2026-05-18T17:00:00',<br>venue: 'Open Air Amphitheatre',<br>attendeeName: 'Vikramaditya Roy',<br>rollNo: '2022ECE05',<br>email: 'v.roy@univ.edu',<br>phone: '9988776655',<br>tier: 'Standard Entry',<br>quantity: 3,<br>paidAmount: 750,<br>bookingTime: '2026-04-03 18:45',<br>checkedIn: false<br>}<br>];<br><br>// Active Application State<br>let appState = {<br>events: [],<br>bookings: [],<br>selectedEvent: null,<br>activeCategory: 'all',<br>searchQuery: '',<br>bookingForm: {<br>tier: 'standard',<br>tierMultiplier: 1,<br>quantity: 1,<br>promoCode: '',<br>discountPercent: 0<br>}<br>};<br><br>// Valid Promo Codes<br>const VALID_PROMOS = {<br>'STUDENT20': 0.20,<br>'EARLYBIRD': 0.15,<br>'FEST50': 0.50,<br>'FREEPASS': 1.00<br>};<br><br>// ==============================================================================<br>// INITIALIZATION<br>// ==============================================================================<br>document.addEventListener('DOMContentLoaded', () =&gt; {<br>loadDatabase();<br>setupEventListeners();<br>renderEvents();<br>updateNavigationBadge();<br>updateOrganizerDashboard();<br>startCountdownTimers();<br>});<br><br>// Load data from LocalStorage or initialize defaults<br>function loadDatabase() {<br>try {<br>const storedEvents = localStorage.getItem(STORAGE_KEYS.EVENTS);<br>const storedBookings = localStorage.getItem(STORAGE_KEYS.BOOKINGS);<br><br>appState.events = storedEvents ? JSON.parse(storedEvents) : [...DEFAULT_EVENTS];<br>appState.bookings = storedBookings ? JSON.parse(storedBookings) : [...DEFAULT_BOOKINGS];<br><br>if (!storedEvents) saveEvents();<br>if (!storedBookings) saveBookings();<br>} catch (e) {<br>console.error("Error reading localStorage, using defaults", e);<br>appState.events = [...DEFAULT_EVENTS];<br>appState.bookings = [...DEFAULT_BOOKINGS];<br>}<br>}<br><br>function saveEvents() {<br>localStorage.setItem(STORAGE_KEYS.EVENTS, JSON.stringify(appState.events));<br>}<br><br>function saveBookings() {<br>localStorage.setItem(STORAGE_KEYS.BOOKINGS, JSON.stringify(appState.bookings));<br>}<br><br>// ==============================================================================<br>// NAVIGATION &amp; TABS<br>// ==============================================================================<br>function setupEventListeners() {<br>// Navigation Tabs<br>const navTabs = document.querySelectorAll('.nav-tab');<br>navTabs.forEach(tab =&gt; {<br>tab.addEventListener('click', () =&gt; {<br>navTabs.forEach(t =&gt; t.classList.remove('active'));<br>tab.classList.add('active');<br><br>const targetViewId = tab.getAttribute('data-target');<br>document.querySelectorAll('.view-section').forEach(view =&gt; {<br>view.classList.remove('active');<br>});<br>document.getElementById(targetViewId).classList.add('active');<br><br>if (targetViewId === 'tickets-view') {<br>renderMyTickets();<br>} else if (targetViewId === 'admin-view') {<br>updateOrganizerDashboard();<br>}<br>});<br>});<br><br>// Logo Click -&gt; Go to Events<br>document.getElementById('brand-logo').addEventListener('click', () =&gt; {<br>document.getElementById('tab-events').click();<br>});<br><br>// Search input<br>const searchInput = document.getElementById('event-search-input');<br>searchInput.addEventListener('input', (e) =&gt; {<br>appState.searchQuery = e.target.value.toLowerCase().trim();<br>renderEvents();<br>});<br><br>// Category Filter Pills<br>const pills = document.querySelectorAll('#category-pills .pill-btn');<br>pills.forEach(pill =&gt; {<br>pill.addEventListener('click', () =&gt; {<br>pills.forEach(p =&gt; p.classList.remove('active'));<br>pill.classList.add('active');<br>appState.activeCategory = pill.getAttribute('data-category');<br>renderEvents();<br>});<br>});<br><br>// Demo Mode Actions<br>document.getElementById('btn-seed-data').addEventListener('click', seedSampleData);<br>document.getElementById('btn-reset-demo').addEventListener('click', resetDemoData);<br><br>// Modal Close Buttons<br>document.getElementById('btn-close-booking').addEventListener('click', closeBookingModal);<br>document.getElementById('btn-close-pass').addEventListener('click', closeTicketPassModal);<br>document.getElementById('btn-close-pass-action').addEventListener('click', closeTicketPassModal);<br>document.getElementById('btn-close-new-event').addEventListener('click', closeNewEventModal);<br><br>// Close on backdrop click<br>document.querySelectorAll('.modal-backdrop').forEach(modal =&gt; {<br>modal.addEventListener('click', (e) =&gt; {<br>if (e.target === modal) {<br>modal.classList.remove('active');<br>}<br>});<br>});<br><br>// Booking Quantity Stepper<br>document.getElementById('qty-minus').addEventListener('click', () =&gt; {<br>if (appState.bookingForm.quantity &gt; 1) {<br>appState.bookingForm.quantity--;<br>document.getElementById('book-qty').value = appState.bookingForm.quantity;<br>updateBookingSummary();<br>}<br>});<br><br>document.getElementById('qty-plus').addEventListener('click', () =&gt; {<br>const event = appState.selectedEvent;<br>const maxLimit = Math.min(5, event ? event.availableSeats : 5);<br>if (appState.bookingForm.quantity &lt; maxLimit) {<br>appState.bookingForm.quantity++;<br>document.getElementById('book-qty').value = appState.bookingForm.quantity;<br>updateBookingSummary();<br>} else {<br>showToast(`Maximum limit of ${maxLimit} tickets reached.`, 'warning');<br>}<br>});<br><br>// Tier Selection Radio Buttons<br>const tierRadios = document.querySelectorAll('input[name="ticket-tier"]');<br>tierRadios.forEach(radio =&gt; {<br>radio.addEventListener('change', (e) =&gt; {<br>document.querySelectorAll('.tier-card').forEach(card =&gt; card.classList.remove('active'));<br>e.target.closest('.tier-card').classList.add('active');<br><br>if (e.target.value === 'vip') {<br>appState.bookingForm.tier = 'vip';<br>appState.bookingForm.tierMultiplier = 2.0; // VIP is 2x base price<br>} else {<br>appState.bookingForm.tier = 'standard';<br>appState.bookingForm.tierMultiplier = 1.0;<br>}<br>updateBookingSummary();<br>});<br>});<br><br>// Promo Code Application<br>document.getElementById('btn-apply-promo').addEventListener('click', applyPromoCode);<br><br>// Booking Form Submission<br>document.getElementById('ticket-booking-form').addEventListener('submit', handleBookingSubmit);<br><br>// Print Pass<br>document.getElementById('btn-print-ticket').addEventListener('click', () =&gt; {<br>window.print();<br>});<br><br>// Admin Open Modal<br>document.getElementById('btn-admin-add-event').addEventListener('click', openNewEventModal);<br>document.getElementById('btn-create-event-trigger').addEventListener('click', openNewEventModal);<br>document.getElementById('create-event-form').addEventListener('submit', handleCreateEvent);<br><br>// Admin Search Attendees<br>document.getElementById('admin-search-attendees').addEventListener('input', (e) =&gt; {<br>renderAttendeesTable(e.target.value.toLowerCase().trim());<br>});<br><br>// Export CSV<br>document.getElementById('btn-export-csv').addEventListener('click', exportBookingsCSV);<br>}<br><br>// ==============================================================================<br>// RENDER EVENTS<br>// ==============================================================================<br>function renderEvents() {<br>const grid = document.getElementById('events-grid-list');<br>const counter = document.getElementById('live-events-count');<br><br>// Filter events based on active filters<br>const filtered = appState.events.filter(evt =&gt; {<br>const matchesCategory = appState.activeCategory === 'all' || evt.category === appState.activeCategory;<br>const matchesSearch = !appState.searchQuery || <br>evt.title.toLowerCase().includes(appState.searchQuery) ||<br>evt.department.toLowerCase().includes(appState.searchQuery) ||<br>evt.venue.toLowerCase().includes(appState.searchQuery);<br>return matchesCategory &amp;&amp; matchesSearch;<br>});<br><br>counter.textContent = `${filtered.length} of ${appState.events.length} Events Available`;<br><br>if (filtered.length === 0) {<br>grid.innerHTML = `</p>
<div class="empty-wallet-card"><br>
<div class="empty-icon">🔍</div>
<br>
<h3>No Matching Events Found</h3>
<br>
<p>Try clearing your search query or selecting another category.</p>
</div>
<p><br>`;<br>return;<br>}<br><br>grid.innerHTML = filtered.map(evt =&gt; {<br>const badgeClass = getBadgeClass(evt.category);<br>const dateFormatted = formatEventDate(evt.date);<br>const percentLeft = Math.round((evt.availableSeats / evt.totalSeats) * 100);<br>const isSoldOut = evt.availableSeats &lt;= 0;<br><br>return `</p>
<article class="event-card" data-event-id="${evt.id}"><br>
<div class="card-banner" style="background: ${evt.bannerGrad};"><br><span class="card-badge ${badgeClass}">${evt.category}</span><br><span class="card-timer-tag" data-countdown-date="${evt.date}">Loading...</span></div>
<br>
<div class="card-content"><br><span class="card-dept">🏛️ ${evt.department}</span><br>
<h3 class="card-title">${evt.title}</h3>
<br><br>
<div class="card-meta-list"><br>
<div class="meta-row"><br><span class="icon">🗓️</span><br>${dateFormatted}</div>
<br>
<div class="meta-row"><br><span class="icon">📍</span><br>${evt.venue}</div>
</div>
<br><br>
<div class="seat-inventory-block"><br>
<div class="seat-label-row"><br>Availability<br><span class="seats-remaining ${isSoldOut ? 'sold-out' : ''}"><br>${isSoldOut ? 'SOLD OUT' : `${evt.availableSeats} of ${evt.totalSeats} seats left`}<br></span></div>
<br>
<div class="progress-bar-wrap"><br>
<div class="progress-bar-fill" style="width: ${percentLeft}%; background: ${isSoldOut ? '#ef4444' : 'var(--grad-primary)'};">&nbsp;</div>
</div>
</div>
<br><br>
<div class="card-footer"><br>
<div class="card-price-group"><br><span class="price-sub">Starting from</span><br><span class="price-val">₹${evt.price}</span></div>
<br>
<div class="card-actions"><br><button class="btn-primary ${isSoldOut ? 'btn-disabled' : ''}"> onclick="openBookingModal('${evt.id}')" <br>${isSoldOut ? 'disabled' : ''}&gt;<br>${isSoldOut ? 'Sold Out' : 'Book Tickets'}<br></button></div>
</div>
</div>
</article>
<p><br>`;<br>}).join('');<br>}<br><br>function getBadgeClass(category) {<br>switch (category) {<br>case 'Technical': return 'badge-tech';<br>case 'Workshops': return 'badge-workshop';<br>case 'Cultural': return 'badge-cultural';<br>case 'Gaming': return 'badge-gaming';<br>default: return 'badge-tech';<br>}<br>}<br><br>function formatEventDate(isoDateStr) {<br>try {<br>const d = new Date(isoDateStr);<br>return d.toLocaleDateString('en-US', { <br>weekday: 'short', <br>month: 'short', <br>day: 'numeric', <br>year: 'numeric' <br>}) + ' • ' + d.toLocaleTimeString('en-US', { <br>hour: '2-digit', <br>minute: '2-digit',<br>hour12: true <br>});<br>} catch(e) {<br>return isoDateStr;<br>}<br>}<br><br>// ==============================================================================<br>// BOOKING MODAL LOGIC<br>// ==============================================================================<br>function openBookingModal(eventId) {<br>const event = appState.events.find(e =&gt; e.id === eventId);<br>if (!event) return;<br><br>appState.selectedEvent = event;<br><br>// Reset booking form state<br>appState.bookingForm = {<br>tier: 'standard',<br>tierMultiplier: 1.0,<br>quantity: 1,<br>promoCode: '',<br>discountPercent: 0<br>};<br><br>// Populate modal fields<br>document.getElementById('modal-event-cat').textContent = event.category;<br>document.getElementById('modal-event-name').textContent = event.title;<br>document.getElementById('modal-event-dept').textContent = `${event.department} • ${event.venue}`;<br><br>// Sidebar<br>document.getElementById('m-side-venue').textContent = event.venue;<br>document.getElementById('m-side-datetime').textContent = formatEventDate(event.date);<br>document.getElementById('m-side-seats').textContent = `${event.availableSeats} of ${event.totalSeats} seats available`;<br>const percent = Math.round((event.availableSeats / event.totalSeats) * 100);<br>document.getElementById('m-side-progress').style.width = `${percent}%`;<br><br>// Tier prices<br>document.getElementById('tier-price-std').textContent = `₹${event.price}`;<br>document.getElementById('tier-price-vip').textContent = `₹${event.price * 2}`;<br><br>// Reset controls<br>document.getElementById('book-qty').value = 1;<br>document.querySelector('input[name="ticket-tier"][value="standard"]').checked = true;<br>document.querySelectorAll('.tier-card').forEach(c =&gt; c.classList.remove('active'));<br>document.querySelector('.tier-card input[value="standard"]').closest('.tier-card').classList.add('active');<br><br>document.getElementById('promo-input').value = '';<br>document.getElementById('promo-status-msg').textContent = "Try 'STUDENT20' for 20% off!";<br>document.getElementById('promo-status-msg').style.color = "var(--text-muted)";<br>document.getElementById('summary-discount-row').style.display = 'none';<br><br>// Clear error messages<br>clearFormErrors();<br><br>updateBookingSummary();<br>updateModalTimer(event.date);<br><br>// Show modal<br>document.getElementById('booking-modal').classList.add('active');<br>}<br><br>function closeBookingModal() {<br>document.getElementById('booking-modal').classList.remove('active');<br>}<br><br>function updateBookingSummary() {<br>const event = appState.selectedEvent;<br>if (!event) return;<br><br>const basePerTicket = Math.round(event.price * appState.bookingForm.tierMultiplier);<br>const subtotal = basePerTicket * appState.bookingForm.quantity;<br>const discountAmount = Math.round(subtotal * appState.bookingForm.discountPercent);<br>const finalPayable = Math.max(0, subtotal - discountAmount);<br><br>document.getElementById('summary-qty-count').textContent = appState.bookingForm.quantity;<br>document.getElementById('summary-base-rate').textContent = `₹${subtotal}`;<br><br>if (appState.bookingForm.discountPercent &gt; 0) {<br>document.getElementById('summary-discount-row').style.display = 'flex';<br>document.getElementById('summary-discount-code').textContent = appState.bookingForm.promoCode;<br>document.getElementById('summary-discount-val').textContent = `-₹${discountAmount}`;<br>} else {<br>document.getElementById('summary-discount-row').style.display = 'none';<br>}<br><br>document.getElementById('summary-final-total').textContent = `₹${finalPayable}`;<br>}<br><br>function applyPromoCode() {<br>const input = document.getElementById('promo-input');<br>const msg = document.getElementById('promo-status-msg');<br>const code = input.value.trim().toUpperCase();<br><br>if (!code) {<br>msg.textContent = "Please enter a valid coupon code.";<br>msg.style.color = "#f87171";<br>return;<br>}<br><br>if (VALID_PROMOS[code] !== undefined) {<br>const discount = VALID_PROMOS[code];<br>appState.bookingForm.promoCode = code;<br>appState.bookingForm.discountPercent = discount;<br>msg.textContent = `Success! ${discount * 100}% discount applied.`;<br>msg.style.color = "#34d399";<br>updateBookingSummary();<br>showToast(`Promo ${code} applied successfully!`, 'success');<br>} else {<br>appState.bookingForm.promoCode = '';<br>appState.bookingForm.discountPercent = 0;<br>msg.textContent = "Invalid promo code. Try 'STUDENT20'";<br>msg.style.color = "#f87171";<br>updateBookingSummary();<br>}<br>}<br><br>function clearFormErrors() {<br>document.getElementById('err-name').textContent = '';<br>document.getElementById('err-roll').textContent = '';<br>document.getElementById('err-email').textContent = '';<br>document.getElementById('err-phone').textContent = '';<br>}<br><br>function handleBookingSubmit(e) {<br>e.preventDefault();<br>clearFormErrors();<br><br>const name = document.getElementById('book-full-name').value.trim();<br>const roll = document.getElementById('book-roll-no').value.trim();<br>const email = document.getElementById('book-email').value.trim();<br>const phone = document.getElementById('book-phone').value.trim();<br>const qty = appState.bookingForm.quantity;<br>const event = appState.selectedEvent;<br><br>let hasError = false;<br><br>if (!name) {<br>document.getElementById('err-name').textContent = 'Please enter attendee name.';<br>hasError = true;<br>}<br>if (!roll) {<br>document.getElementById('err-roll').textContent = 'Please provide Student/Faculty ID.';<br>hasError = true;<br>}<br>if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {<br>document.getElementById('err-email').textContent = 'Enter a valid email address.';<br>hasError = true;<br>}<br>if (!phone || phone.length &lt; 10) {<br>document.getElementById('err-phone').textContent = 'Valid 10-digit phone number required.';<br>hasError = true;<br>}<br><br>if (hasError) return;<br><br>// Check inventory<br>if (event.availableSeats &lt; qty) {<br>showToast('Sorry! Not enough tickets remaining.', 'error');<br>return;<br>}<br><br>// Calculate final amount paid<br>const basePerTicket = Math.round(event.price * appState.bookingForm.tierMultiplier);<br>const subtotal = basePerTicket * qty;<br>const discountAmount = Math.round(subtotal * appState.bookingForm.discountPercent);<br>const finalPaid = Math.max(0, subtotal - discountAmount);<br><br>// Create unique ticket ID<br>const randomHex = Math.floor(10000 + Math.random() * 90000);<br>const prefix = event.title.substring(0, 2).toUpperCase();<br>const ticketId = `${prefix}-${randomHex}`;<br><br>// Deduct seats<br>event.availableSeats -= qty;<br>saveEvents();<br><br>// Create booking record<br>const newBooking = {<br>ticketId: ticketId,<br>eventId: event.id,<br>eventName: event.title,<br>eventDept: event.department,<br>eventDate: event.date,<br>venue: event.venue,<br>attendeeName: name,<br>rollNo: roll,<br>email: email,<br>phone: phone,<br>tier: appState.bookingForm.tier === 'vip' ? 'VIP Delegate 🌟' : 'Standard Entry',<br>quantity: qty,<br>paidAmount: finalPaid,<br>bookingTime: new Date().toISOString().replace('T', ' ').substring(0, 16),<br>checkedIn: false<br>};<br><br>appState.bookings.unshift(newBooking);<br>saveBookings();<br><br>// Reset Form<br>document.getElementById('ticket-booking-form').reset();<br>closeBookingModal();<br><br>// Refresh UI<br>renderEvents();<br>updateNavigationBadge();<br>updateOrganizerDashboard();<br><br>// Show Pass Preview<br>showTicketPassModal(newBooking);<br>showToast(`Tickets Confirmed! Pass ID: ${ticketId}`, 'success');<br>}<br><br>// ==============================================================================<br>// DIGITAL E-TICKET PASS &amp; SVG QR GENERATOR<br>// ==============================================================================<br>function showTicketPassModal(booking) {<br>document.getElementById('t-pass-event-name').textContent = booking.eventName;<br>document.getElementById('t-pass-event-dept').textContent = `${booking.eventDept}`;<br>document.getElementById('t-pass-tier').textContent = booking.tier;<br><br>document.getElementById('t-pass-name').textContent = booking.attendeeName;<br>document.getElementById('t-pass-roll').textContent = booking.rollNo;<br>document.getElementById('t-pass-datetime').textContent = formatEventDate(booking.eventDate);<br>document.getElementById('t-pass-venue').textContent = booking.venue;<br>document.getElementById('t-pass-qty').textContent = `${booking.quantity} ${booking.quantity &gt; 1 ? 'Tickets' : 'Ticket'}`;<br>document.getElementById('t-pass-amount').textContent = `₹${booking.paidAmount}`;<br>document.getElementById('t-pass-id').textContent = booking.ticketId;<br><br>// Render Clean High-Tech SVG QR Code<br>renderQrCodeSvg('t-pass-qr-container', booking.ticketId);<br><br>document.getElementById('ticket-pass-modal').classList.add('active');<br>}<br><br>function closeTicketPassModal() {<br>document.getElementById('ticket-pass-modal').classList.remove('active');<br>}<br><br>// Built-in Procedural High-Tech SVG QR Matrix<br>function renderQrCodeSvg(containerId, seedText) {<br>const container = document.getElementById(containerId);<br>if (!container) return;<br><br>// 21x21 QR Version 1 layout simulation<br>const size = 21;<br>let hash = 0;<br>for (let i = 0; i &lt; seedText.length; i++) {<br>hash = ((hash &lt;&lt; 5) - hash) + seedText.charCodeAt(i);<br>hash |= 0;<br>}<br><br>let rects = '';<br>for (let r = 0; r &lt; size; r++) {<br>for (let c = 0; c &lt; size; c++) {<br>// Corner position detection patterns (3 corners)<br>const isTopLeft = (r &lt; 7 &amp;&amp; c &lt; 7);<br>const isTopRight = (r &lt; 7 &amp;&amp; c &gt;= size - 7);<br>const isBottomLeft = (r &gt;= size - 7 &amp;&amp; c &lt; 7);<br><br>let isDark = false;<br><br>if (isTopLeft || isTopRight || isBottomLeft) {<br>// Finder patterns<br>const localR = isBottomLeft ? r - (size - 7) : r;<br>const localC = isTopRight ? c - (size - 7) : c;<br>if (localR === 0 || localR === 6 || localC === 0 || localC === 6) {<br>isDark = true;<br>} else if (localR &gt;= 2 &amp;&amp; localR &lt;= 4 &amp;&amp; localC &gt;= 2 &amp;&amp; localC &lt;= 4) {<br>isDark = true;<br>}<br>} else if (r === 6 || c === 6) {<br>// Timing pattern<br>isDark = (r + c) % 2 === 0;<br>} else {<br>// Pseudo-random pseudo-data based on seed hash<br>const cellHash = Math.sin(hash + r * 13 + c * 37) * 10000;<br>isDark = (cellHash - Math.floor(cellHash)) &gt; 0.45;<br>}<br><br>if (isDark) {<br>rects += ``;<br>}<br>}<br>}<br><br>const svg = `<br><br><br>${rects}<br><br>`;<br>container.innerHTML = svg;<br>}<br><br>// ==============================================================================<br>// MY TICKETS WALLET VIEW<br>// ==============================================================================<br>function renderMyTickets() {<br>const list = document.getElementById('my-tickets-list');<br><br>if (appState.bookings.length === 0) {<br>list.innerHTML = `</p>
<div class="empty-wallet-card"><br>
<div class="empty-icon">🎟️</div>
<br>
<h3>No Tickets Booked Yet</h3>
<br>
<p>Browse upcoming department events and reserve your pass.</p>
<br><button class="btn-primary" style="margin-top: 18px;"><br>Browse Events<br></button></div>
<p><br>`;<br>return;<br>}<br><br>list.innerHTML = appState.bookings.map(booking =&gt; {<br>return `</p>
<div class="glass-panel" style="padding: 24px; display: flex; flex-direction: column; gap: 14px; position: relative;"><br>
<div style="display: flex; justify-content: space-between; align-items: flex-start;"><br>
<div><br><span class="badge-pill" style="color: var(--accent-cyan);">${booking.eventDept}</span><br>
<h3 style="font-size: 1.15rem; margin-top: 4px;">${booking.eventName}</h3>
</div>
<br><span class="badge-count" style="background: rgba(99, 102, 241, 0.25); color: #c7d2fe;">${booking.tier}</span></div>
<br><br>
<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 0.82rem; color: var(--text-muted);"><br>
<div>👤 Attendee: <strong style="color: #fff;">${booking.attendeeName}</strong></div>
<br>
<div>🆔 Pass ID: <strong style="color: var(--accent-cyan); font-family: monospace;">${booking.ticketId}</strong></div>
<br>
<div>🗓️ Date: <span style="color: #cbd5e1;">${formatEventDate(booking.eventDate)}</span></div>
<br>
<div>📍 Venue: <span style="color: #cbd5e1;">${booking.venue}</span></div>
<br>
<div>👥 Seats: <span style="color: #cbd5e1;">${booking.quantity} Person(s)</span></div>
<br>
<div>💰 Paid: <strong style="color: #34d399;">₹${booking.paidAmount}</strong></div>
</div>
<br><br>
<div style="display: flex; gap: 10px; margin-top: 8px; padding-top: 12px; border-top: 1px solid rgba(255, 255, 255, 0.08);"><br><button class="btn-primary" style="flex: 1; padding: 7px 14px; font-size: 0.8rem;"><br>🔍 View &amp; Print Pass<br></button><br><span class="status-tag ${booking.checkedIn ? 'status-checked-in' : 'status-confirmed'}"><br>${booking.checkedIn ? 'Checked In' : 'Confirmed'}<br></span></div>
</div>
<p><br>`;<br>}).join('');<br>}<br><br>function viewPassModalByTicketId(ticketId) {<br>const booking = appState.bookings.find(b =&gt; b.ticketId === ticketId);<br>if (booking) {<br>showTicketPassModal(booking);<br>}<br>}<br><br>function updateNavigationBadge() {<br>const countBadge = document.getElementById('nav-ticket-count');<br>countBadge.textContent = appState.bookings.length;<br>}<br><br>// ==============================================================================<br>// ORGANIZER DASHBOARD &amp; ANALYTICS<br>// ==============================================================================<br>function updateOrganizerDashboard() {<br>let totalTickets = 0;<br>let totalRevenue = 0;<br>let totalCapacity = 0;<br>let totalSeatsBooked = 0;<br>let totalCheckedIn = 0;<br><br>appState.events.forEach(e =&gt; {<br>totalCapacity += e.totalSeats;<br>totalSeatsBooked += (e.totalSeats - e.availableSeats);<br>});<br><br>appState.bookings.forEach(b =&gt; {<br>totalTickets += b.quantity;<br>totalRevenue += b.paidAmount;<br>if (b.checkedIn) totalCheckedIn += b.quantity;<br>});<br><br>const occupancyRate = totalCapacity &gt; 0 ? Math.round((totalSeatsBooked / totalCapacity) * 100) : 0;<br><br>document.getElementById('metric-total-tickets').textContent = totalTickets;<br>document.getElementById('metric-total-revenue').textContent = `₹${totalRevenue.toLocaleString('en-IN')}`;<br>document.getElementById('metric-occupancy').textContent = `${occupancyRate}%`;<br>document.getElementById('metric-capacity-text').textContent = `${totalSeatsBooked} / ${totalCapacity} Total Seats Occupied`;<br>document.getElementById('metric-checked-in').textContent = totalCheckedIn;<br>document.getElementById('metric-checkin-percent').textContent = `${totalTickets &gt; 0 ? Math.round((totalCheckedIn / totalTickets) * 100) : 0}% of attendees admitted`;<br><br>renderAttendeesTable();<br>}<br><br>function renderAttendeesTable(searchQuery = '') {<br>const tbody = document.getElementById('bookings-table-body');<br>const countBadge = document.getElementById('attendees-table-count');<br><br>const filtered = appState.bookings.filter(b =&gt; {<br>if (!searchQuery) return true;<br>return b.attendeeName.toLowerCase().includes(searchQuery) ||<br>b.rollNo.toLowerCase().includes(searchQuery) ||<br>b.ticketId.toLowerCase().includes(searchQuery) ||<br>b.eventName.toLowerCase().includes(searchQuery);<br>});<br><br>countBadge.textContent = `${filtered.length} Records`;<br><br>if (filtered.length === 0) {<br>tbody.innerHTML = `<br><br><br>No matching bookings found in the roster.<br><br><br>`;<br>return;<br>}<br><br>tbody.innerHTML = filtered.map(b =&gt; {<br>return `<br><br>${b.ticketId}<br><strong>${b.attendeeName}</strong><br><span style="font-family: monospace; color: var(--text-muted);">${b.rollNo}</span><br>${b.eventName}<br>${b.quantity}<br>₹${b.paidAmount}<br>${b.bookingTime}<br><br><span class="status-tag ${b.checkedIn ? 'status-checked-in' : 'status-confirmed'}"><br>${b.checkedIn ? 'Checked In' : 'Confirmed'}<br></span><br><br><br><button class="btn-table-action"><br>${b.checkedIn ? 'Undo Check-in' : 'Check In'}<br></button><br><br><br>`;<br>}).join('');<br>}<br><br>function toggleCheckInStatus(ticketId) {<br>const booking = appState.bookings.find(b =&gt; b.ticketId === ticketId);<br>if (!booking) return;<br><br>booking.checkedIn = !booking.checkedIn;<br>saveBookings();<br>updateOrganizerDashboard();<br>showToast(`${booking.attendeeName} ${booking.checkedIn ? 'checked in successfully!' : 'check-in undone.'}`, 'info');<br>}<br><br>// Export Bookings to CSV<br>function exportBookingsCSV() {<br>if (appState.bookings.length === 0) {<br>showToast('No booking records to export.', 'warning');<br>return;<br>}<br><br>const headers = ['Ticket ID', 'Attendee Name', 'Roll No', 'Email', 'Phone', 'Event Name', 'Venue', 'Tier', 'Quantity', 'Paid (INR)', 'Booking Time', 'Checked In'];<br>const rows = appState.bookings.map(b =&gt; [<br>`"${b.ticketId}"`,<br>`"${b.attendeeName}"`,<br>`"${b.rollNo}"`,<br>`"${b.email}"`,<br>`"${b.phone}"`,<br>`"${b.eventName}"`,<br>`"${b.venue}"`,<br>`"${b.tier}"`,<br>b.quantity,<br>b.paidAmount,<br>`"${b.bookingTime}"`,<br>b.checkedIn ? 'YES' : 'NO'<br>]);<br><br>const csvContent = 'data:text/csv;charset=utf-8,' + [headers.join(','), ...rows.map(r =&gt; r.join(','))].join('\n');<br>const encodedUri = encodeURI(csvContent);<br>const link = document.createElement('a');<br>link.setAttribute('href', encodedUri);<br>link.setAttribute('download', `EventHub_Bookings_Report_${new Date().toISOString().substring(0, 10)}.csv`);<br>document.body.appendChild(link);<br>link.click();<br>document.body.removeChild(link);<br><br>showToast('Exported CSV roster successfully!', 'success');<br>}<br><br>// ==============================================================================<br>// ADD NEW EVENT MODAL LOGIC<br>// ==============================================================================<br>function openNewEventModal() {<br>document.getElementById('new-event-modal').classList.add('active');<br>}<br><br>function closeNewEventModal() {<br>document.getElementById('new-event-modal').classList.remove('active');<br>}<br><br>function handleCreateEvent(e) {<br>e.preventDefault();<br><br>const name = document.getElementById('new-event-name').value.trim();<br>const dept = document.getElementById('new-event-dept').value.trim();<br>const category = document.getElementById('new-event-category').value;<br>const date = document.getElementById('new-event-date').value;<br>const venue = document.getElementById('new-event-venue').value.trim();<br>const price = parseInt(document.getElementById('new-event-price').value, 10) || 0;<br>const seats = parseInt(document.getElementById('new-event-seats').value, 10) || 50;<br>const desc = document.getElementById('new-event-desc').value.trim() || 'Exciting department symposium with presentations and cash awards.';<br><br>if (!name || !dept || !date || !venue) {<br>showToast('Please fill out all required fields.', 'warning');<br>return;<br>}<br><br>const gradients = [<br>'linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%)',<br>'linear-gradient(135deg, #8b5cf6 0%, #d946ef 100%)',<br>'linear-gradient(135deg, #0ea5e9 0%, #10b981 100%)',<br>'linear-gradient(135deg, #f59e0b 0%, #ef4444 100%)'<br>];<br>const bannerGrad = gradients[Math.floor(Math.random() * gradients.length)];<br><br>const newEvent = {<br>id: `evt-${Date.now().toString().slice(-4)}`,<br>title: name,<br>department: dept,<br>category: category,<br>date: date,<br>venue: venue,<br>price: price,<br>totalSeats: seats,<br>availableSeats: seats,<br>desc: desc,<br>bannerGrad: bannerGrad<br>};<br><br>appState.events.unshift(newEvent);<br>saveEvents();<br><br>document.getElementById('create-event-form').reset();<br>closeNewEventModal();<br>renderEvents();<br>updateOrganizerDashboard();<br><br>// Switch view to events<br>document.getElementById('tab-events').click();<br>showToast(`Published "${name}" successfully!`, 'success');<br>}<br><br>// ==============================================================================<br>// COUNTDOWN TIMERS<br>// ==============================================================================<br>function startCountdownTimers() {<br>setInterval(() =&gt; {<br>const timerTags = document.querySelectorAll('[data-countdown-date]');<br>const now = new Date().getTime();<br><br>timerTags.forEach(tag =&gt; {<br>const targetDateStr = tag.getAttribute('data-countdown-date');<br>const target = new Date(targetDateStr).getTime();<br>const diff = target - now;<br><br>if (diff &lt;= 0) {<br>tag.textContent = '● Live / Completed';<br>tag.style.color = '#34d399';<br>} else {<br>const days = Math.floor(diff / (1000 * 60 * 60 * 24));<br>const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));<br>const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));<br>tag.textContent = `⏳ ${days}d ${hours}h left`;<br>}<br>});<br><br>// Also update modal countdown if active<br>if (appState.selectedEvent) {<br>updateModalTimer(appState.selectedEvent.date);<br>}<br>}, 1000);<br>}<br><br>function updateModalTimer(targetDateStr) {<br>const target = new Date(targetDateStr).getTime();<br>const now = new Date().getTime();<br>const diff = target - now;<br><br>const daysEl = document.getElementById('m-cd-days');<br>const hoursEl = document.getElementById('m-cd-hours');<br>const minsEl = document.getElementById('m-cd-mins');<br>const secsEl = document.getElementById('m-cd-secs');<br><br>if (!daysEl) return;<br><br>if (diff &lt;= 0) {<br>daysEl.textContent = '00';<br>hoursEl.textContent = '00';<br>minsEl.textContent = '00';<br>secsEl.textContent = '00';<br>} else {<br>const days = Math.floor(diff / (1000 * 60 * 60 * 24));<br>const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));<br>const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));<br>const secs = Math.floor((diff % (1000 * 60)) / 1000);<br><br>daysEl.textContent = String(days).padStart(2, '0');<br>hoursEl.textContent = String(hours).padStart(2, '0');<br>minsEl.textContent = String(mins).padStart(2, '0');<br>secsEl.textContent = String(secs).padStart(2, '0');<br>}<br>}<br><br>// ==============================================================================<br>// DEMO CONTROLS (SEED &amp; RESET)<br>// ==============================================================================<br>function seedSampleData() {<br>const demoNames = ['Neha Sharma', 'Karthik Raja', 'Meera Nair', 'Tanmay Joshi', 'Ananya Deshmukh'];<br>const rolls = ['2023CS041', '2024ECE18', '2022IT092', '2025MECH33', '2023AI014'];<br><br>let addedCount = 0;<br>demoNames.forEach((name, idx) =&gt; {<br>const randomEvt = appState.events[Math.floor(Math.random() * appState.events.length)];<br>if (randomEvt.availableSeats &gt; 2) {<br>randomEvt.availableSeats -= 1;<br>const newB = {<br>ticketId: `EH-${Math.floor(20000 + Math.random() * 70000)}`,<br>eventId: randomEvt.id,<br>eventName: randomEvt.title,<br>eventDept: randomEvt.department,<br>eventDate: randomEvt.date,<br>venue: randomEvt.venue,<br>attendeeName: name,<br>rollNo: rolls[idx],<br>email: `${name.toLowerCase().replace(' ', '.')}@univ.edu`,<br>phone: `98${Math.floor(10000000 + Math.random() * 90000000)}`,<br>tier: idx % 2 === 0 ? 'VIP Delegate 🌟' : 'Standard Entry',<br>quantity: 1,<br>paidAmount: idx % 2 === 0 ? randomEvt.price * 2 : randomEvt.price,<br>bookingTime: `2026-04-0${idx + 4} 11:${10 + idx * 8}`,<br>checkedIn: idx === 0<br>};<br>appState.bookings.unshift(newB);<br>addedCount++;<br>}<br>});<br><br>saveEvents();<br>saveBookings();<br>renderEvents();<br>updateNavigationBadge();<br>updateOrganizerDashboard();<br><br>showToast(`Seeded ${addedCount} sample attendee bookings for presentation!`, 'success');<br>}<br><br>function resetDemoData() {<br>if (confirm("Reset all events and bookings back to initial demo defaults?")) {<br>localStorage.removeItem(STORAGE_KEYS.EVENTS);<br>localStorage.removeItem(STORAGE_KEYS.BOOKINGS);<br>loadDatabase();<br>renderEvents();<br>updateNavigationBadge();<br>updateOrganizerDashboard();<br>showToast("Demo data reset to factory defaults!", 'info');<br>}<br>}<br><br>// ==============================================================================<br>// TOAST NOTIFICATION SYSTEM<br>// ==============================================================================<br>function showToast(message, type = 'info') {<br>const container = document.getElementById('toast-container');<br>if (!container) return;<br><br>const toast = document.createElement('div');<br>toast.className = `toast toast-${type}`;<br><br>let icon = 'ℹ️';<br>if (type === 'success') icon = '✅';<br>if (type === 'warning') icon = '⚠️';<br>if (type === 'error') icon = '❌';<br><br>toast.innerHTML = `${icon}${message}`;<br>container.appendChild(toast);<br><br>setTimeout(() =&gt; {<br>toast.classList.add('toast-fadeout');<br>setTimeout(() =&gt; toast.remove(), 300);<br>}, 3500);<br>}</p></body></html>